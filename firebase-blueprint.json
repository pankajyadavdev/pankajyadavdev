{
  "entities": {
    "Transmission": {
      "title": "Transmission",
      "description": "A contact message received from the portfolio website",
      "type": "object",
      "properties": {
        "transmissionId": {
          "type": "string",
          "description": "Unique identifier for the transmission"
        },
        "name": {
          "type": "string",
          "description": "Name of the sender"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Email address of the sender"
        },
        "message": {
          "type": "string",
          "description": "Message content of the transmission"
        },
        "timestampString": {
          "type": "string",
          "description": "User-friendly timestamp string generated client-side"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the record was created"
        }
      },
      "required": ["transmissionId", "name", "email", "message", "timestampString", "createdAt"]
    }
  },
  "firestore": {
    "/transmissions/{transmissionId}": {
      "schema": "Transmission",
      "description": "Collection of contact messages received from the portfolio website"
    }
  }
}
